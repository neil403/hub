# Copy to .env (same folder) and fill in. .env is gitignored and must never
# be copied into the vault: the vault syncs to your phone.
#
# Each phase adds the keys it needs here, with where to get them.

# --- Core (Phase 1) -----------------------------------------------------------
# Optional. Overrides vault_path in config.yaml. Useful for pointing a test run
# at a scratch folder. Leave blank to use config.yaml.
HUB_VAULT_PATH=
